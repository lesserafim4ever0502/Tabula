{
  "manifest_version": 3,
  "name": "Tabula",
  "version": "1.0.0",
  "description": "Minimalist start page, a clean and efficient dual-mode search and bookmark tool.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' blob: data:;"
  }
}
